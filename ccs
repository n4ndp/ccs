#!/usr/bin/env python3
"""ccs - Claude Code account switcher.

Keeps several Claude Code logins side by side and swaps the active one in place.
Switching rewrites the live credentials file, so running Claude Code sessions
pick up the new account without a restart.
"""

import argparse
import contextlib
import datetime
import fcntl
import json
import os
import re
import shutil
import sys
import tempfile
from pathlib import Path

VERSION = "0.1.0"
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
MAX_BACKUPS = 20


class CcsError(Exception):
    pass


# --- paths -----------------------------------------------------------------
def home() -> Path:
    return Path(os.environ.get("HOME") or Path.home())


def config_dir() -> Path:
    custom = os.environ.get("CLAUDE_CONFIG_DIR")
    return Path(custom).expanduser() if custom else home() / ".claude"


def live_credentials_path() -> Path:
    return config_dir() / ".credentials.json"


def live_state_path() -> Path:
    # Claude Code keeps .claude.json in $HOME unless CLAUDE_CONFIG_DIR is set.
    if os.environ.get("CLAUDE_CONFIG_DIR"):
        return config_dir() / ".claude.json"
    return home() / ".claude.json"


def store_dir() -> Path:
    custom = os.environ.get("CCS_HOME")
    return Path(custom).expanduser() if custom else home() / ".claude-accounts"


def orca_accounts_dir() -> Path:
    return home() / ".config" / "orca" / "claude-accounts"


def orca_system_default_snapshot() -> Path:
    return home() / ".config" / "orca" / "claude-runtime-auth" / "system-default-auth.json"


# --- io helpers ------------------------------------------------------------
def read_json(path: Path):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except FileNotFoundError:
        return None
    except json.JSONDecodeError as exc:
        raise CcsError(f"{path} is not valid JSON: {exc}") from exc


def write_json_atomic(path: Path, data, mode: int = 0o600) -> None:
    """Write via temp file + rename so readers never see a half-written file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(data, fh, indent=2)
            fh.write("\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)
        raise


def ensure_private_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)
    os.chmod(path, 0o700)


@contextlib.contextmanager
def store_lock():
    ensure_private_dir(store_dir())
    with open(store_dir() / ".lock", "w") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


# --- domain ----------------------------------------------------------------
def validate_name(name: str) -> str:
    if not NAME_RE.match(name):
        raise CcsError(f"invalid account name '{name}': use letters, digits, '.', '_' or '-'")
    return name


def live_account():
    """Return (credentials, oauthAccount) of the currently logged-in Claude Code account."""
    credentials = read_json(live_credentials_path())
    state = read_json(live_state_path()) or {}
    oauth_account = state.get("oauthAccount")
    if not credentials or not oauth_account or not oauth_account.get("accountUuid"):
        raise CcsError(
            "no Claude Code login found "
            f"({live_credentials_path()} / {live_state_path()}). Run `claude` and log in first."
        )
    return credentials, oauth_account


def live_uuid():
    state = read_json(live_state_path()) or {}
    return (state.get("oauthAccount") or {}).get("accountUuid")


def saved_names():
    if not store_dir().is_dir():
        return []
    return sorted(
        p.name for p in store_dir().iterdir()
        if p.is_dir() and not p.name.startswith(".") and (p / "account.json").exists()
    )


def load_saved(name: str):
    folder = store_dir() / name
    oauth_account = read_json(folder / "account.json")
    credentials = read_json(folder / "credentials.json")
    if not oauth_account or not credentials:
        raise CcsError(f"no saved account named '{name}'. See `ccs list`.")
    return credentials, oauth_account


def find_by_uuid(uuid: str):
    for name in saved_names():
        if (read_json(store_dir() / name / "account.json") or {}).get("accountUuid") == uuid:
            return name
    return None


def write_saved(name: str, credentials, oauth_account) -> None:
    folder = store_dir() / name
    ensure_private_dir(folder)
    write_json_atomic(folder / "credentials.json", credentials)
    write_json_atomic(folder / "account.json", oauth_account)


def backup_live() -> Path:
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    target = store_dir() / ".backups" / stamp
    ensure_private_dir(target.parent)
    ensure_private_dir(target)
    for src, dst in ((live_credentials_path(), "credentials.json"), (live_state_path(), "claude.json")):
        if src.exists():
            shutil.copy2(src, target / dst)
            os.chmod(target / dst, 0o600)
    backups = sorted((store_dir() / ".backups").iterdir())
    for old in backups[:-MAX_BACKUPS]:
        shutil.rmtree(old, ignore_errors=True)
    return target


def describe(oauth_account) -> str:
    email = oauth_account.get("emailAddress") or "?"
    org = oauth_account.get("organizationName")
    return f"{email} ({org})" if org else email


# --- commands --------------------------------------------------------------
def cmd_list(_args) -> int:
    names = saved_names()
    active = live_uuid()
    if not names:
        print("No saved accounts. Log in with `claude`, then run `ccs save <name>`.")
    width = max((len(n) for n in names), default=0)
    for name in names:
        oauth_account = read_json(store_dir() / name / "account.json") or {}
        marker = "*" if active and oauth_account.get("accountUuid") == active else " "
        print(f"{marker} {name.ljust(width)}  {describe(oauth_account)}")
    if active and not find_by_uuid(active):
        state = read_json(live_state_path()) or {}
        print(f"\nActive login {describe(state.get('oauthAccount') or {})} is not saved. Run `ccs save <name>`.")
    return 0


def cmd_current(_args) -> int:
    active = live_uuid()
    if not active:
        raise CcsError("no Claude Code login found.")
    name = find_by_uuid(active)
    if not name:
        raise CcsError("the active login is not saved. Run `ccs save <name>`.")
    print(name)
    return 0


def cmd_save(args) -> int:
    name = validate_name(args.name)
    with store_lock():
        credentials, oauth_account = live_account()
        uuid = oauth_account["accountUuid"]
        existing = find_by_uuid(uuid)
        if existing and existing != name:
            raise CcsError(f"this login is already saved as '{existing}'.")
        current = read_json(store_dir() / name / "account.json")
        if current and current.get("accountUuid") != uuid and not args.force:
            raise CcsError(f"'{name}' holds a different account ({describe(current)}). Use --force to replace it.")
        write_saved(name, credentials, oauth_account)
    print(f"Saved {describe(oauth_account)} as '{name}'.")
    return 0


def cmd_use(args) -> int:
    name = validate_name(args.name)
    with store_lock():
        target_credentials, target_account = load_saved(name)
        active = live_uuid()
        if active == target_account["accountUuid"]:
            print(f"'{name}' is already active.")
            return 0
        if active:
            active_name = find_by_uuid(active)
            if not active_name:
                raise CcsError(
                    "the active login is not saved and would be lost. "
                    "Run `ccs save <name>` first."
                )
            # A running session may have refreshed the token; keep the newest copy.
            live_credentials, live_oauth = live_account()
            write_saved(active_name, live_credentials, live_oauth)
        backup_live()
        state = read_json(live_state_path()) or {}
        state["oauthAccount"] = target_account
        state_mode = live_state_path().stat().st_mode & 0o777 if live_state_path().exists() else 0o600
        write_json_atomic(live_credentials_path(), target_credentials)
        write_json_atomic(live_state_path(), state, mode=state_mode)
    print(f"Switched to '{name}' - {describe(target_account)}.")
    return 0


def cmd_remove(args) -> int:
    name = validate_name(args.name)
    with store_lock():
        folder = store_dir() / name
        if not (folder / "account.json").exists():
            raise CcsError(f"no saved account named '{name}'.")
        shutil.rmtree(folder)
    print(f"Removed '{name}'. The live login was not touched.")
    return 0


def orca_candidates():
    """Yield (credentials, oauthAccount) for every login Orca keeps on disk."""
    for auth in sorted(orca_accounts_dir().glob("*/auth")):
        yield read_json(auth / ".credentials.json"), read_json(auth / "oauth-account.json")
    # Copy-based switching snapshots the original login it replaced ("System default").
    snapshot = read_json(orca_system_default_snapshot()) or {}
    raw = snapshot.get("credentialsJson")
    if raw:
        try:
            yield json.loads(raw), snapshot.get("configOauthAccount")
        except json.JSONDecodeError:
            print("ccs: skipping unreadable Orca System default snapshot.", file=sys.stderr)


def cmd_import_orca(_args) -> int:
    if not orca_accounts_dir().is_dir() and not orca_system_default_snapshot().exists():
        raise CcsError(f"no Orca accounts found in {orca_accounts_dir().parent}.")
    active = live_uuid()
    imported = 0
    with store_lock():
        for credentials, oauth_account in orca_candidates():
            if not oauth_account or not credentials or not oauth_account.get("accountUuid"):
                continue
            uuid = oauth_account["accountUuid"]
            if find_by_uuid(uuid):
                continue
            if uuid == active:
                # The live copy is the freshest; Orca's may hold a rotated refresh token.
                credentials = live_account()[0]
            base = re.sub(r"[^A-Za-z0-9._-]", "-", (oauth_account.get("emailAddress") or uuid).split("@")[0]) or "account"
            name, n = base, 2
            while (store_dir() / name).exists():
                name, n = f"{base}-{n}", n + 1
            write_saved(validate_name(name), credentials, oauth_account)
            print(f"Imported {describe(oauth_account)} as '{name}'.")
            imported += 1
    if not imported:
        print("Nothing new to import.")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="ccs", description="Switch between Claude Code accounts.")
    parser.add_argument("--version", action="version", version=f"ccs {VERSION}")
    sub = parser.add_subparsers(dest="command", metavar="<command>")
    sub.add_parser("list", aliases=["ls"], help="list saved accounts (* = active)").set_defaults(func=cmd_list)
    sub.add_parser("current", help="print the active account name").set_defaults(func=cmd_current)
    p = sub.add_parser("save", help="save the currently logged-in account under NAME")
    p.add_argument("name")
    p.add_argument("--force", action="store_true", help="replace a different account saved under NAME")
    p.set_defaults(func=cmd_save)
    p = sub.add_parser("use", help="make NAME the active account (running sessions follow)")
    p.add_argument("name")
    p.set_defaults(func=cmd_use)
    p = sub.add_parser("remove", aliases=["rm"], help="forget a saved account")
    p.add_argument("name")
    p.set_defaults(func=cmd_remove)
    sub.add_parser("import-orca", help="import accounts saved by the Orca app").set_defaults(func=cmd_import_orca)
    return parser


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        args = parser.parse_args(["list"])
    try:
        return args.func(args)
    except CcsError as exc:
        print(f"ccs: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
